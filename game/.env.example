# Local development only (`npm run dev`). Nothing here is a secret the game needs at runtime:
# the title and environment come from src/idos.title.ts / src/config.ts.
VITE_IDOS_TITLE_ID=QA0X2DY9
# Optional: WalletConnect / Reown project id for wallet login outside the idosgames.com frame
VITE_WALLETCONNECT_PROJECT_ID=
# Optional: Google sign-in client id (empty hides the button)
VITE_IDOS_GOOGLE_CLIENT_ID=
